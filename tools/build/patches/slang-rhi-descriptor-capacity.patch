+bool getDemand(const std::vector<VkDescriptorSetLayoutBinding>& bindings, DescriptorDemand& demand)
+{
+    for (const auto& binding : bindings)
+    {
+        const auto found = std::find(std::begin(Types), std::end(Types), binding.descriptorType);
+        if (found == std::end(Types)) return false;
+        auto& count = demand.counts[found - std::begin(Types)];
+        if (binding.descriptorCount > std::numeric_limits<uint32_t>::max() - count) return false;
+        count += binding.descriptorCount;
+        if (binding.descriptorType == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK_EXT && binding.descriptorCount)
+            ++demand.inlineBindings;
+    }
+    return true;
+}
+bool fits(const DescriptorSetAllocator::Pool& pool, const DescriptorDemand& demand)
+{
+    if (pool.exhausted || !pool.remainingSets || demand.inlineBindings > pool.remaining.inlineBindings) return false;
+    for (size_t i = 0; i < DescriptorDemand::TypeCount; ++i)
+        if (demand.counts[i] > pool.remaining.counts[i]) return false;
+    return true;
+}
