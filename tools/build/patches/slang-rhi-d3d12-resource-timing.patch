diff --git a/src/d3d12/d3d12-resource-timing.h b/src/d3d12/d3d12-resource-timing.h
new file mode 100644
index 0000000..7113829
--- /dev/null
+++ b/src/d3d12/d3d12-resource-timing.h
@@ -0,0 +1,115 @@
+#pragma once
+
+#include "d3d12-api.h"
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+
+namespace rhi::d3d12 {
+
+// Opt-in wall/CPU intervals. The threshold changes diagnostics only, never work.
+class ResourceTiming
+{
+public:
+    std::uint64_t count = 0;
+    std::uint64_t bytes = 0;
+
+    ResourceTiming(const char* operation, std::uint64_t size = 0, std::uint64_t items = 0,
+        D3D12MA::Allocator* allocator = nullptr, unsigned heap = 0)
+        : count(items), bytes(size), m_operation(operation), m_active(enabled()), m_allocator(allocator), m_heap(heap)
+    {
+        if (m_active)
+        {
+            m_thread = GetCurrentThreadId();
+            m_start = now();
+            m_cpuValid = cpuTime(m_cpu);
+        }
+    }
+    ~ResourceTiming() { finish(); }
+    bool active() const { return m_active; }
+    void stop()
+    {
+        if (!m_active || m_stopped)
+            return;
+        m_end = now();
+        if (m_end - m_start >= 10000000)
+            m_endCpuValid = cpuTime(m_endCpu);
+        m_stopped = true;
+    }
+    void finish()
+    {
+        if (!m_active)
+            return;
+        stop();
+        m_active = false;
+        const auto end = m_end;
+        if (end - m_start < 10000000)
+            return;
+        const bool valid = m_endCpuValid && m_cpuValid;
+        // One stdio operation keeps concurrent producer records together.
+        std::fprintf(stderr,
+            "rhi_d3d12_timing op=%s thread_id=%lu start_ns=%llu end_ns=%llu "
+            "wall_ms=%.6f thread_cpu_ms=%.6f count=%llu bytes=%llu heap=%u\n",
+            m_operation, static_cast<unsigned long>(m_thread),
+            static_cast<unsigned long long>(m_start), static_cast<unsigned long long>(end),
+            double(end - m_start) / 1e6, valid ? double(m_endCpu - m_cpu) / 1e6 : -1.0,
+            static_cast<unsigned long long>(count), static_cast<unsigned long long>(bytes), m_heap);
+        if (m_allocator)
+        {
+            // The operation has ended; memory-budget queries are timed separately.
+            D3D12MA::Budget local{}, nonlocal{};
+            ResourceTiming query("budget_query");
+            const auto queryStart = now();
+            m_allocator->GetBudget(&local, &nonlocal);
+            const auto queryEnd = now();
+            query.finish();
+            std::fprintf(stderr,
+                "rhi_d3d12_budget thread_id=%lu operation_start_ns=%llu sampled_ns=%llu query_ms=%.6f "
+                "local_usage_bytes=%llu local_budget_bytes=%llu local_block_bytes=%llu local_allocation_bytes=%llu "
+                "nonlocal_usage_bytes=%llu nonlocal_budget_bytes=%llu nonlocal_block_bytes=%llu nonlocal_allocation_bytes=%llu\n",
+                static_cast<unsigned long>(m_thread), static_cast<unsigned long long>(m_start),
+                static_cast<unsigned long long>(queryEnd), double(queryEnd - queryStart) / 1e6,
+                static_cast<unsigned long long>(local.UsageBytes), static_cast<unsigned long long>(local.BudgetBytes),
+                static_cast<unsigned long long>(local.Stats.BlockBytes), static_cast<unsigned long long>(local.Stats.AllocationBytes),
+                static_cast<unsigned long long>(nonlocal.UsageBytes), static_cast<unsigned long long>(nonlocal.BudgetBytes),
+                static_cast<unsigned long long>(nonlocal.Stats.BlockBytes), static_cast<unsigned long long>(nonlocal.Stats.AllocationBytes));
+        }
+    }
+
+private:
+    static bool enabled()
+    {
+        static const bool value = [] {
+            char value[2]{};
+            return GetEnvironmentVariableA("SLANG_RHI_D3D12_RESOURCE_TIMING", value, sizeof(value)) == 1 &&
+                value[0] == '1';
+        }();
+        return value;
+    }
+    static std::uint64_t now()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    static bool cpuTime(std::uint64_t& value)
+    {
+        FILETIME created{}, exited{}, kernel{}, user{};
+        if (!GetThreadTimes(GetCurrentThread(), &created, &exited, &kernel, &user))
+            return false;
+        const auto ticks = [](FILETIME time) {
+            return (std::uint64_t(time.dwHighDateTime) << 32) | time.dwLowDateTime;
+        };
+        value = (ticks(kernel) + ticks(user)) * 100;
+        return true;
+    }
+    const char* m_operation;
+    bool m_active = false, m_cpuValid = false;
+    bool m_stopped = false, m_endCpuValid = false;
+    DWORD m_thread = 0;
+    std::uint64_t m_start = 0, m_cpu = 0;
+    std::uint64_t m_end = 0, m_endCpu = 0;
+    D3D12MA::Allocator* m_allocator = nullptr;
+    unsigned m_heap = 0;
+};
+
+} // namespace rhi::d3d12
