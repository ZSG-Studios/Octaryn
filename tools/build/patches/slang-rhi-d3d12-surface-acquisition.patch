diff --git a/src/d3d12/d3d12-surface-acquisition.h b/src/d3d12/d3d12-surface-acquisition.h
new file mode 100644
index 0000000..2c34e19
--- /dev/null
+++ b/src/d3d12/d3d12-surface-acquisition.h
@@ -0,0 +1,16 @@
+#pragma once
+#include <cstdint>
+
+namespace rhi {
+// Presentation retirement must not outlive the engine heartbeat deadline.
+inline constexpr std::uint32_t d3d_image_wait_ms = 2000;
+
+template<class Wait, class Reset, class Abort>
+bool d3d_wait_image_event(Wait wait, Reset reset, Abort abort)
+{
+    if (wait(d3d_image_wait_ms) == 0 && reset())
+        return true;
+    abort();
+    return false;
+}
+} // namespace rhi
