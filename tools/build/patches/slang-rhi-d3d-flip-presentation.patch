diff --git a/src/d3d/d3d-presentation.h b/src/d3d/d3d-presentation.h
new file mode 100644
index 0000000..6ad3c83
--- /dev/null
+++ b/src/d3d/d3d-presentation.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <dxgi1_5.h>
+
+namespace rhi {
+
+constexpr bool d3d_allow_tearing(DXGI_SWAP_EFFECT effect, bool vsync, bool supported)
+{
+    const bool flip = effect == DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL || effect == DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    return flip && !vsync && supported;
+}
+
+constexpr UINT d3d_present_flags(bool allowed, bool vsync, bool fullscreen)
+{
+    return allowed && !vsync && !fullscreen ? DXGI_PRESENT_ALLOW_TEARING : 0;
+}
+
+} // namespace rhi
