 Result SurfaceImpl::present()
 {
-    if (!m_configured)
-    {
+    if (!m_configured || m_acquiredImage < 0)
         return SLANG_FAIL;
-    }
-    SLANG_D3D_RETURN_ON_FAIL_REPORT(
-        m_fence->SetEventOnCompletion(fenceValue, m_frameEvents[m_swapChain3->GetCurrentBackBufferIndex()]),
-        m_device
-    );
-    SLANG_RETURN_ON_FAIL(D3DSurface::present());
-    fenceValue++;
-    m_queue->Signal(m_fence, fenceValue);
-    return SLANG_OK;
+    const auto image = m_acquiredImage;
+    const auto abort = [&]() {
+        m_configured = false;
+        m_acquiredImage = -1;
+        SetEvent(m_frameEvents[image]);
+    };
+    const auto result = d3d_retire_image(fenceValue,
+        [&](uint64_t value) -> Result {
+            SLANG_D3D_RETURN_ON_FAIL_REPORT(m_fence->SetEventOnCompletion(value, m_frameEvents[image]), m_device);
+            return SLANG_OK;
+        },
+        [&]() { return D3DSurface::present(); },
+        [&](uint64_t value) -> Result {
+            SLANG_D3D_RETURN_ON_FAIL_REPORT(m_queue->Signal(m_fence, value), m_device);
+            return SLANG_OK;
+        }, abort);
+    m_acquiredImage = -1;
+    return result;
 }
 
 } // namespace rhi::d3d12
