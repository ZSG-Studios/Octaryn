diff --git a/src/d3d12/d3d12-surface-retirement.h b/src/d3d12/d3d12-surface-retirement.h
new file mode 100644
index 0000000..7609c22
--- /dev/null
+++ b/src/d3d12/d3d12-surface-retirement.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+namespace rhi {
+
+// Reserve one new completion point for this image; every failure poisons its
+// presentation state so an unsignalled image event cannot strand reacquisition.
+template<class Register, class Present, class Signal, class Abort>
+std::int32_t d3d_retire_image(std::uint64_t& fenceValue, Register registerEvent, Present present, Signal signal, Abort abort)
+{
+    if (fenceValue == (std::numeric_limits<std::uint64_t>::max)())
+    {
+        abort();
+        return -1;
+    }
+    const auto reserved = fenceValue + 1;
+    auto result = registerEvent(reserved);
+    if (result >= 0)
+    {
+        fenceValue = reserved;
+        result = present();
+        if (result >= 0)
+            result = signal(reserved);
+    }
+    if (result < 0)
+        abort();
+    return result;
+}
+
+} // namespace rhi
