@@ -64,37 +66,53 @@ Result SurfaceImpl::configure(const SurfaceConfig& config)
 
 Result SurfaceImpl::unconfigure()
 {
+    m_acquiredImage = -1;
+    for (auto event : m_frameEvents)
+        SetEvent(event);
     return D3DSurface::unconfigure();
 }
 
 Result SurfaceImpl::acquireNextImage(ITexture** outTexture)
 {
-    if (!m_configured)
+    *outTexture = nullptr;
+    if (!m_configured || m_acquiredImage >= 0)
+        return SLANG_FAIL;
+    const auto index = m_swapChain3->GetCurrentBackBufferIndex();
+    if (index >= m_textures.size() || index >= m_frameEvents.size())
+        return SLANG_FAIL;
+    if (WaitForSingleObject(m_frameEvents[index], INFINITE) != WAIT_OBJECT_0 ||
+        !m_configured || !ResetEvent(m_frameEvents[index]))
     {
-        *outTexture = nullptr;
+        m_configured = false;
         return SLANG_FAIL;
     }
-    auto result = (int)m_swapChain3->GetCurrentBackBufferIndex();
-    WaitForSingleObject(m_frameEvents[result], INFINITE);
-    ResetEvent(m_frameEvents[result]);
-    returnComPtr(outTexture, m_textures[result]);
+    m_acquiredImage = int(index);
