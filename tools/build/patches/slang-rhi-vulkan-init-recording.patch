+Result VulkanDeviceQueue::init(const VulkanApi& api, VkQueue queue, int queueIndex)
+{
+    SLANG_RHI_ASSERT(!m_api);
+    m_api = &api;
+    m_queue = queue;
+    for (auto& slot : m_slots)
+    {
+        VkCommandPoolCreateInfo pool = {VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        pool.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+        pool.queueFamilyIndex = queueIndex;
+        if (api.vkCreateCommandPool(api.m_device, &pool, nullptr, &slot.pool) != VK_SUCCESS) return SLANG_FAIL;
+        VkCommandBufferAllocateInfo commands = {VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        commands.commandPool = slot.pool;
+        commands.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        commands.commandBufferCount = 1;
+        if (api.vkAllocateCommandBuffers(api.m_device, &commands, &slot.commands) != VK_SUCCESS) return SLANG_FAIL;
+        VkFenceCreateInfo fence = {VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        if (api.vkCreateFence(api.m_device, &fence, nullptr, &slot.fence) != VK_SUCCESS) return SLANG_FAIL;
+    }
+    return SLANG_OK;
+}
+int VulkanDeviceQueue::acquire()
+{
+    std::unique_lock<std::mutex> lock(m_slotsMutex);
+    for (;;)
+    {
+        for (bool active : {false, true})
+            for (int i = 0; i < kMaxCommandBuffers; ++i)
+                if (!m_slots[i].leased && m_slots[i].active == active)
+                {
+                    m_slots[i].leased = true;
+                    return i;
+                }
+        m_slotsAvailable.wait(lock);
     }
 }
