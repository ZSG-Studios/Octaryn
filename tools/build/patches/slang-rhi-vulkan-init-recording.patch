+VkResult VulkanDeviceQueue::complete(Slot& slot, bool wait)
+{
+    if (!slot.active) return VK_SUCCESS;
+    VkResult result = m_api->vkWaitForFences(m_api->m_device, 1, &slot.fence, VK_TRUE, wait ? UINT64_MAX : 0);
+    if (result != VK_SUCCESS) return result;
+    result = m_api->vkResetFences(m_api->m_device, 1, &slot.fence);
+    if (result != VK_SUCCESS) return result;
+    slot.active = false;
+    // Destruction can re-enter resource retirement; no queue/slot mutex is held.
+    slot.retained.clear();
+    return VK_SUCCESS;
+}
