diff --git a/src/d3d12/d3d12-surface-completion.h b/src/d3d12/d3d12-surface-completion.h
new file mode 100644
index 0000000..c7d2581
--- /dev/null
+++ b/src/d3d12/d3d12-surface-completion.h
@@ -0,0 +1,54 @@
+#pragma once
+#include <cstdint>
+#include <limits>
+#include "d3d12-surface-acquisition.h"
+
+namespace rhi {
+struct D3DImageCompletion
+{
+    bool admitted = false;
+    std::uint64_t before = 0, after = 0, elapsedMs = 0;
+    std::uint32_t waits = 0, waitStatus = 0, reason = 0;
+};
+
+// Events only notify. The fence predicate owns image admission, including lost
+// notifications and device removal (GetCompletedValue returns UINT64_MAX).
+template<class Completed, class Arm, class Wait, class Now, class Abort>
+D3DImageCompletion d3d_wait_image_completion(std::uint64_t target, Completed completed, Arm arm,
+    Wait wait, Now now, Abort abort)
+{
+    D3DImageCompletion result;
+    const auto start = now();
+    result.before = completed();
+    result.after = result.before;
+    bool rearm = true;
+    for (unsigned iteration = 0; iteration < 4096; ++iteration)
+    {
+        if (result.after == (std::numeric_limits<std::uint64_t>::max)())
+        { result.reason = 1; break; }
+        if (result.after >= target)
+        { result.admitted = true; return result; }
+        const auto current = now();
+        if (current < start) { result.reason = 2; break; }
+        result.elapsedMs = current - start;
+        if (result.elapsedMs >= d3d_image_wait_ms) { result.reason = 3; break; }
+        if (rearm && !arm(target)) { result.reason = 4; break; }
+        result.after = completed();
+        if (result.after >= target) continue;
+        const auto remaining = d3d_image_wait_ms - result.elapsedMs;
+        const auto timeout = std::uint32_t(remaining < 20 ? remaining : 20);
+        result.waitStatus = wait(timeout);
+        ++result.waits;
+        result.after = completed();
+        const auto end = now();
+        if (end < start) { result.reason = 2; break; }
+        result.elapsedMs = end - start;
+        if (result.waitStatus != 0 && result.waitStatus != 258)
+        { result.reason = 5; break; }
+        rearm = result.waitStatus == 0;
+    }
+    if (result.reason == 0) result.reason = 6;
+    abort();
+    return result;
+}
+} // namespace rhi
