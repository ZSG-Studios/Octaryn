+VkResult VulkanDeviceQueue::observeError(VkResult result, bool sticky)
+{
+    if (result == VK_ERROR_DEVICE_LOST) m_initializationError.store(result);
+    else if (sticky && result != VK_SUCCESS)
+    {
+        VkResult expected = VK_SUCCESS;
+        m_initializationError.compare_exchange_strong(expected, result);
+    }
+    return result;
