diff --git a/src/core/resource-retirement.h b/src/core/resource-retirement.h
new file mode 100644
index 0000000..28db9a0
--- /dev/null
+++ b/src/core/resource-retirement.h
@@ -0,0 +1,143 @@
+#pragma once
+
+#include <algorithm>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace rhi {
+
+struct ResourceRetirementSnapshot
+{
+    uint64_t pendingCount = 0;
+    uint64_t pendingBufferBytes = 0;
+    uint64_t peakCount = 0;
+    uint64_t peakBufferBytes = 0;
+    uint32_t activeCount = 0;
+};
+
+// Owns only fence-eligible destruction; command buffers remain on the queue thread.
+template<typename T>
+class ResourceRetirement
+{
+public:
+    using DeleteFn = void (*)(T*);
+
+    explicit ResourceRetirement(DeleteFn destroy, size_t maxQueued = 256)
+        : m_destroy(destroy)
+        , m_entries(std::max<size_t>(1, maxQueued))
+        , m_worker([this] { run(); })
+    {}
+
+    ~ResourceRetirement() { finish(); }
+    ResourceRetirement(const ResourceRetirement&) = delete;
+    ResourceRetirement& operator=(const ResourceRetirement&) = delete;
+
+    // False leaves ownership with the caller. The active destructor consumes a slot.
+    bool enqueue(T* resource, uint64_t epoch, uint64_t bufferBytes)
+    {
+        if (!resource)
+            return false;
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (m_closing || m_stats.pendingCount >= m_entries.size() ||
+                bufferBytes > UINT64_MAX - m_stats.pendingBufferBytes)
+                return false;
+            m_entries[(m_first + m_count) % m_entries.size()] = {resource, epoch, bufferBytes};
+            ++m_count;
+            ++m_stats.pendingCount;
+            m_stats.pendingBufferBytes += bufferBytes;
+            m_stats.peakCount = std::max(m_stats.peakCount, m_stats.pendingCount);
+            m_stats.peakBufferBytes = std::max(m_stats.peakBufferBytes, m_stats.pendingBufferBytes);
+        }
+        m_changed.notify_all();
+        return true;
+    }
+
+    void advance(uint64_t completed)
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_completed = std::max(m_completed, completed);
+        }
+        m_changed.notify_all();
+    }
+
+    ResourceRetirementSnapshot info() const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return m_stats;
+    }
+
+    // Shutdown only: the owner must first advance the completed GPU fence.
+    void waitForCapacity()
+    {
+        std::unique_lock<std::mutex> lock(m_mutex);
+        m_changed.wait(lock, [this] { return m_stats.pendingCount < m_entries.size(); });
+    }
+
+    // Does not bypass unfinished epochs. No producer may enqueue after this call.
+    void finish()
+    {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_closing = true;
+        }
+        m_changed.notify_all();
+        if (m_worker.joinable())
+            m_worker.join();
+    }
+
+private:
+    struct Entry
+    {
+        T* resource = nullptr;
+        uint64_t epoch = 0;
+        uint64_t bytes = 0;
+    };
+
+    void run()
+    {
+        for (;;)
+        {
+            Entry entry;
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_changed.wait(lock, [this] {
+                    return (m_closing && !m_count) ||
+                           (m_count && m_entries[m_first].epoch <= m_completed);
+                });
+                if (!m_count)
+                    break;
+                entry = m_entries[m_first];
+                m_entries[m_first] = {};
+                m_first = (m_first + 1) % m_entries.size();
+                --m_count;
+                m_stats.activeCount = 1;
+            }
+            m_destroy(entry.resource);
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                --m_stats.pendingCount;
+                m_stats.pendingBufferBytes -= entry.bytes;
+                m_stats.activeCount = 0;
+            }
+            m_changed.notify_all();
+        }
+    }
+
+    DeleteFn m_destroy;
+    std::vector<Entry> m_entries;
+    mutable std::mutex m_mutex;
+    std::condition_variable m_changed;
+    size_t m_first = 0;
+    size_t m_count = 0;
+    uint64_t m_completed = 0;
+    bool m_closing = false;
+    ResourceRetirementSnapshot m_stats;
+    std::thread m_worker;
+};
+
+} // namespace rhi
