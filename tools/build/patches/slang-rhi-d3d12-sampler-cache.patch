+Result BindingDataBuilder::finalizeSamplerTables()
+{
+    // Sampler tables are immutable until their command buffer is reset.
+    for (const auto& table : m_samplerTables)
+    {
+        GPUDescriptorRange allocation;
+        for (const auto& cached : m_bindingCache->samplerTables)
+        {
+            if (cached.descriptors == table.descriptors)
+            {
+                allocation = cached.allocation;
+                break;
+            }
+        }
+        if (!allocation.isValid())
+        {
+            allocation = m_samplerArena->allocate(uint32_t(table.descriptors.size()));
+            if (!allocation.isValid())
+                return SLANG_E_OUT_OF_MEMORY;
+            for (uint32_t i = 0; i < allocation.count; ++i)
+            {
+                m_device->m_device->CopyDescriptorsSimple(
+                    1, allocation.getCpuHandle(i), {table.descriptors[i]}, D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER
+                );
+            }
+            m_bindingCache->samplerTables.push_back({table.descriptors, allocation});
+        }
+        m_bindingData->rootParameters[table.rootParameterIndex] =
+            createRootDescriptorTable(table.rootParameterIndex, allocation.firstGpuHandle);
+    }
+    return SLANG_OK;
+}
