body {
    font-family: Silkscreen;
    font-size: 18px;
    color: #dce7f5;
    width: 100%;
    height: 100%;
    margin: 0;
}

#menu-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background: #0b0f16;
}

#menu-root.framed {
    background: #00000000;
}

.screen {
    position: absolute;
    left: 18%; top: 10%; right: 18%;
    display: none;
}

.screen.active {
    display: block;
}

#screen-main, #screen-worlds, #screen-connect, #screen-settings, #screen-pause {
    background: #101724ee;
    border: 2px #2c3f5f;
    padding: 36px 44px;
}

h1 {
    font-size: 40px;
    color: #ffffff;
    margin-bottom: 6px;
}

h2 {
    font-size: 24px;
    color: #9fc2ff;
    margin-bottom: 18px;
}

.subtitle {
    font-size: 14px;
    color: #6d84a8;
    margin-bottom: 28px;
}

button {
    display: block;
    width: 100%;
    font-family: Silkscreen;
    font-size: 20px;
    color: #dce7f5;
    background: #1b2a44;
    border: 2px #37507c;
    padding: 12px 18px;
    margin-bottom: 12px;
    text-align: left;
    cursor: pointer;
}

button:hover {
    background: #27406b;
    color: #ffffff;
}

button.danger {
    border-color: #7c3750;
    background: #441b2a;
}

button.danger:hover {
    background: #6b2440;
}

.row {
    margin-bottom: 14px;
}

.row label {
    display: block;
    font-size: 14px;
    color: #8aa3c7;
    margin-bottom: 4px;
}

input[type="text"] {
    font-family: Silkscreen;
    font-size: 18px;
    color: #ffffff;
    background: #0b111c;
    border: 2px #37507c;
    padding: 10px 12px;
    width: 100%;
}

input[type="range"] {
    width: 100%;
}

select {
    font-family: Silkscreen;
    font-size: 16px;
    color: #ffffff;
    background: #0b111c;
    border: 2px #37507c;
    padding: 8px 10px;
    width: 100%;
}

.status {
    font-size: 14px;
    color: #7fae7f;
    margin-top: 10px;
}

.worlds {
    margin-bottom: 16px;
}

.world-name {
    color: #ffffff;
}

.world-path {
    display: block;
    font-size: 12px;
    color: #6d84a8;
}

.footer {
    position: absolute;
    left: 0; right: 0; bottom: 24px;
    text-align: center;
    font-size: 13px;
    color: #4d628a;
}
